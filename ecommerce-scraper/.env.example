# ============================================
# ecommerce-scraper 配置示例
# 复制为 .env 并填入你的凭据
# ============================================

# Apify（推荐，开启双轨对比）
# 注册：https://apify.com/
APIFY_TOKEN=
APIFY_MAX_CHARGE_USD=10.0

# OpenAI（LLM 提取，可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 代理（可选，留空则直连）
# 格式: http://user:pass@host:port
# 推荐: Bright Data / Smartproxy / IPRoyal
PROXY_URL=

# 限流
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_JITTER=0.5

# 对比阈值
AGREEMENT_THRESHOLD_WARN=0.85
AGREEMENT_THRESHOLD_ALERT=0.70
PRICE_TOLERANCE_PCT=0.05

# 存储
DB_PATH=data/scraper.db
DIVERGENCE_LOG_DIR=data/divergences

# 行为模拟
MOUSE_MOVE_MIN_MS=200
MOUSE_MOVE_MAX_MS=800
SCROLL_PAUSE_MIN_MS=500
SCROLL_PAUSE_MAX_MS=1500

# 调试
DEBUG=false
SAVE_RAW_HTML=false

# ============================================
# 中国电商商家 API 凭据（按需配置）
# ============================================

# 淘宝 / 天猫
# 申请: https://open.taobao.com
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ACCESS_TOKEN=

# 京东
# 申请: https://open.jd.com
JD_APP_KEY=
JD_APP_SECRET=
JD_ACCESS_TOKEN=

# 抖店 / 抖音电商
# 申请: https://op.jinritemai.com
DOUYIN_SHOP_APP_KEY=
DOUYIN_SHOP_APP_SECRET=
DOUYIN_SHOP_ACCESS_TOKEN=

# 拼多多
# 申请: https://open.pinduoduo.com
PINDUODUO_APP_KEY=
PINDUODUO_APP_SECRET=
PINDUODUO_ACCESS_TOKEN=

# 1688
# 申请: https://open.1688.com
_1688_APP_KEY=
_1688_APP_SECRET=
_1688_ACCESS_TOKEN=
