#!/usr/bin/env sh
# Pre-commit Hook - 强制执行 6 项检查
# 用途: 在 git commit 时自动执行
# 设计: 防错式 - 任何一项失败都禁止提交
# 变更（V3.0）：第 6 步接入 ESLint，覆盖 SPEC-A §2.3 验收项

echo "🔍 Pre-commit 检查开始..."

# 1. 类型检查
echo "1/6 TypeScript 类型检查"
npx tsc --noEmit || { echo "❌ TypeScript 类型检查失败"; exit 1; }

# 2. 单元测试
echo "2/6 单元测试"
npm test -- --run || { echo "❌ 单元测试失败"; exit 1; }

# 3. SPEC 对照检查
echo "3/6 SPEC 对照检查"
node scripts/check-spec-coverage.js || { echo "❌ SPEC 对照检查失败"; exit 1; }

# 4. 设计保留检查
echo "4/6 设计保留检查"
node scripts/check-design-preservation.js || { echo "❌ 设计保留检查失败"; exit 1; }

# 5. 组件适配检查
echo "5/6 组件适配检查"
node scripts/check-component-adapters.js || { echo "❌ 组件适配检查失败"; exit 1; }

# 6. ESLint 规则（V3.0 接入，覆盖 SPEC-A §2.3 验收项）
echo "6/6 ESLint 规则"
npm run lint:eslint || { echo "❌ ESLint 检查失败"; exit 1; }

echo "✅ 所有 Pre-commit 检查通过"
