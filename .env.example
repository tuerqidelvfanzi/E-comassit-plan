# ============================================================
# 电商助手项目 - 环境变量模板
# ============================================================
# 使用方式：
#   1. 复制本文件：cp .env.example .env
#   2. 填入真实值（.env 已被 .gitignore 忽略）
#   3. 永远不要把真实 .env 提交到 Git
# ============================================================

# ---- API 服务 ----
PORT=8080
# JWT 签名密钥（生产环境必填，建议 32+ 字节随机串）
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
DATABASE_PATH=./data/app.db

# ---- Worker ----
ENABLE_BATCH_WORKER=true
PLAYWRIGHT_HEADLESS=true

# ---- Web 前端 ----
VITE_PORT=3004
VITE_PROXY_TARGET=http://localhost:8080
VITE_BASE_PATH=/E-comassit-plan

# ---- LazyGit 节俭同步（可选） ----
# NOTEBOOKLM_CLI=C:/path/to/notebooklm.exe

# ---- 第三方 API（按需） ----
# ALIYUN_SMS_ACCESS_KEY=
# ALIYUN_SMS_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
