{
  "manifest_version": 3,
  "name": "商品选品助手",
  "description": "演示版：源站采集 → 后台采集箱编辑 → 卖家后台草稿发布",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "商品选品助手"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "http://localhost:3004/*",
    "https://tuerqidelvfanzi.github.io/*",
    "https://*.1688.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.yangkeduo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://detail.1688.com/*"],
      "js": ["content/1688.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*",
        "https://mobile.yangkeduo.com/*"
      ],
      "js": ["content/generic.js"],
      "run_at": "document_idle"
    }
  ]
}
