{
  "manifest_version": 3,
  "name": "商品选品助手",
  "description": "从源站采集商品数据到工作台，并支持写入卖家后台草稿箱（原型）",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "商品选品助手"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:3004/*",
    "https://*.1688.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://detail.1688.com/*"],
      "js": ["content/1688.js"],
      "run_at": "document_idle"
    }
  ]
}
