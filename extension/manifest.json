{
  "manifest_version": 3,
  "name": "电商AI助手",
  "version": "3.1.0",
  "description": "跨境运营智能上品中枢 - 采集/改写/发布",
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "tabs",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.tmall.hk/*",
    "https://*.yangkeduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.shopee.*/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.1688.com/offer/*",
        "https://*.taobao.com/item/*",
        "https://*.tmall.com/item/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*"
      ],
      "js": ["src/content/content-script.js"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.shopee.*/seller/*",
        "https://*.tiktok.com/shop/*"
      ],
      "js": ["src/content/publish-script.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/shared/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
